# RoomBeacon post-Silver runtime settings.
# Copy to .env.local (git-ignored) and fill the empty secrets:
#   cp .env.local.example .env.local && chmod 600 .env.local
# The snapshot job, warehouse loader and ClickHouse service read ONLY this
# file; they never open .env.

# ---------------------------------------------------------------------------
# Bronze snapshot job, when run on the host (python -m analytics.bronze.snapshot)
# Inside Docker the scheduler keeps its existing Bronze connection settings.
# ---------------------------------------------------------------------------
BRONZE_MYSQL_HOST_ACCESS_HOST=127.0.0.1
BRONZE_MYSQL_HOST_PORT=3307

# ---------------------------------------------------------------------------
# ClickHouse bootstrap admin (used only by the clickhouse container on first
# start to create the database and the accounts below).
# ---------------------------------------------------------------------------
CLICKHOUSE_USER=roombeacon_admin
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=roombeacon_dw

# ---------------------------------------------------------------------------
# Warehouse loader (Airflow DAG roombeacon_warehouse_load / CLI).
# Least-privilege account: SELECT/INSERT/CREATE/DROP/TRUNCATE on CLICKHOUSE_DB only.
# Passwords: 16-128 chars of [A-Za-z0-9._~+=@%^-]
# ---------------------------------------------------------------------------
WAREHOUSE_ENABLED=false
WAREHOUSE_CLICKHOUSE_HOST=clickhouse
WAREHOUSE_CLICKHOUSE_HOST_ACCESS_HOST=127.0.0.1
WAREHOUSE_CLICKHOUSE_PORT=8123
WAREHOUSE_CLICKHOUSE_DATABASE=roombeacon_dw
WAREHOUSE_CLICKHOUSE_USER=roombeacon_loader
WAREHOUSE_CLICKHOUSE_PASSWORD=
WAREHOUSE_CLICKHOUSE_SECURE=false
WAREHOUSE_CONNECT_TIMEOUT_SECONDS=10
WAREHOUSE_QUERY_TIMEOUT_SECONDS=300

# Optional read-only account for a future API / BI client (SELECT on CLICKHOUSE_DB).
WAREHOUSE_READER_USER=
WAREHOUSE_READER_PASSWORD=
