# RoomBeacon web UI — copy to .env.local (git-ignored) and fill the key.
#   cp .env.example .env.local
#
# Backend RoomBeacon API (FastAPI, docker compose profile "api") on this machine.
ROOMBEACON_API_URL=http://127.0.0.1:8000
# RAW API key (not the sha256). Read ONLY by the Vite dev-server proxy, which
# injects it as X-API-Key; it is never exposed to the browser bundle.
# Never prefix it with VITE_.
ROOMBEACON_API_KEY=
# Path the browser calls; the dev proxy forwards /api/* to ROOMBEACON_API_URL.
VITE_API_BASE_PATH=/api/v1
# Dev server port for the UI.
VITE_DEV_PORT=5173
