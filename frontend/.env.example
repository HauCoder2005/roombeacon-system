# RoomBeacon web UI (Next.js) — copy to .env.local (git-ignored) and fill the key.
#   cp .env.example .env.local
#
# Backend RoomBeacon API (FastAPI, docker compose profile "api").
# Host dev: http://127.0.0.1:8000   Inside Docker (compose): http://api:8000
ROOMBEACON_API_URL=http://127.0.0.1:8000
# RAW API key (not the sha256). Read ONLY by server-side code (lib/api/server.ts,
# app/api/rb route handler). Never prefix it with NEXT_PUBLIC_.
ROOMBEACON_API_KEY=
# Server-side cache for API data (seconds); warehouse data changes once a day.
REVALIDATE_SECONDS=300
# Next.js port.
PORT=3000
# Public site origin, used for absolute share-image URLs (Open Graph).
SITE_URL=http://localhost:3000
