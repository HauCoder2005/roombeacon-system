# ==============================================================================
# RoomBeacon — Git Ignore Configuration
# ==============================================================================

# ==============================================================================
# RoomBeacon Persistent Runtime Data (Host-Backed Storage)
# ==============================================================================
/data/*
!/data/.gitkeep

# Persistent services / runtime data
/data/mysql/
/data/minio/
/data/bronze/
/data/state/
/data/manifests/
/data/discovery/
/data/analytics/
/data/backups/

# Processing & staging layers
/data/raw/
/data/silver/
/data/gold/
/data/exports/
/data/temp/

# Local data formats
*.parquet
*.csv
*.tsv
*.jsonl
*.feather

# ==============================================================================
# Environment Variables & Secrets
# ==============================================================================
.env
.env.*
.env.local
.env.*.local
*.local.env
*.pem
*.key
*.cert
secrets/

# Keep the template tracked
!.env.example

# ==============================================================================
# Python & Virtual Environments
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.env.venv/
.poetry/

# Testing, Coverage & Code Quality
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# ==============================================================================
# IDEs, Editors & OS Files
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, IntelliJ)
.idea/
*.iml
*.iws

# Sublime Text & Vim
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*.swn

# ==============================================================================
# Apache Airflow Local Runtime
# ==============================================================================
airflow/logs/*
!airflow/logs/.gitkeep
airflow/standalone_admin_password.txt
airflow/airflow.db
airflow/airflow.db-journal

# ==============================================================================
# Databases & Analytical Engines
# ==============================================================================
*.duckdb
*.duckdb.wal
*.duckdb.tmp
*.sqlite
*.sqlite3
*.db
*.db-journal

# ==============================================================================
# Browser Automation & Crawling Artifacts
# ==============================================================================
.playwright/
playwright-report/
test-results/
screenshots/
har/

# ==============================================================================
# Docker & Deployment Overrides
# ==============================================================================
docker-compose.override.yml

# ==============================================================================
# Logs & Temp Files
# ==============================================================================
*.log
*.tmp
*.pid
