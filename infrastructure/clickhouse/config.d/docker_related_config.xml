<!-- Replaces the image's docker_related_config.xml (which also listens on [::]).
     IPv6 is disabled on the RoomBeacon Docker networks, so the [::] listeners only
     produced startup warnings. Host exposure is still limited by the compose port
     map: HTTP on 127.0.0.1:8123 only. -->
<clickhouse>
    <listen_host>0.0.0.0</listen_host>
    <listen_try>1</listen_try>
</clickhouse>
