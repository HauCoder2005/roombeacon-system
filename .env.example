# ============================================================
# ROOMBEACON
# ============================================================

COMPOSE_PROJECT_NAME=roombeacon

ROOMBEACON_ENV=development
ROOMBEACON_PROJECT_NAME=roombeacon
ROOMBEACON_TIMEZONE=Asia/Ho_Chi_Minh

TZ=Asia/Ho_Chi_Minh

LOG_LEVEL=INFO
PYTHONUNBUFFERED=1


# ============================================================
# DOCKER IMAGES / VERSIONS
# ============================================================

MYSQL_IMAGE=mysql
MYSQL_VERSION=8.4

MINIO_IMAGE=minio/minio
MINIO_VERSION=latest

AIRFLOW_IMAGE=apache/airflow
AIRFLOW_VERSION=3.3.1

DUCKDB_IMAGE=duckdb/duckdb
DUCKDB_VERSION=1.5.5

CLICKHOUSE_IMAGE=clickhouse/clickhouse-server
CLICKHOUSE_VERSION=26.3.19.3-lts

NGINX_IMAGE=nginx
NGINX_VERSION=1.28


# ============================================================
# DOCKER NETWORKS
# ============================================================

ROOMBEACON_EDGE_NETWORK=roombeacon-edge-net
ROOMBEACON_DATA_NETWORK=roombeacon-data-net
ROOMBEACON_ORCHESTRATION_NETWORK=roombeacon-orchestration-net


# ============================================================
# DOCKER VOLUMES
# ============================================================

BRONZE_MYSQL_VOLUME=roombeacon-mysql-bronze-data
AIRFLOW_MYSQL_VOLUME=roombeacon-mysql-airflow-data

MINIO_VOLUME=roombeacon-minio-data

CLICKHOUSE_VOLUME=roombeacon-clickhouse-data

AIRFLOW_LOGS_VOLUME=roombeacon-airflow-logs


# ============================================================
# PROJECT DATA PATHS
# ============================================================

ROOMBEACON_DATA_DIR=./data
ROOMBEACON_CONTAINER_DATA_DIR=/data

RAW_DATA_DIR=./data/raw
BRONZE_DATA_DIR=./data/bronze
SILVER_DATA_DIR=./data/silver
GOLD_DATA_DIR=./data/gold

DUCKDB_DATA_DIR=./data/duckdb

BACKUP_DIR=./backups
SECRETS_DIR=./secrets


# ============================================================
# MYSQL IMAGE COMMON CONFIG
# ============================================================

MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci


# ============================================================
# MYSQL #1 — ROOMBEACON BRONZE / LANDING DATABASE
# ============================================================

BRONZE_MYSQL_CONTAINER_NAME=roombeacon-mysql-bronze

BRONZE_MYSQL_HOST=mysql-bronze
BRONZE_MYSQL_PORT=3306

# Port dùng từ Ubuntu host
BRONZE_MYSQL_HOST_PORT=3307

BRONZE_MYSQL_ROOT_PASSWORD=CHANGE_ME_BRONZE_ROOT_PASSWORD

BRONZE_MYSQL_DATABASE=roombeacon_bronze

BRONZE_MYSQL_USER=roombeacon_crawler
BRONZE_MYSQL_PASSWORD=CHANGE_ME_BRONZE_CRAWLER_PASSWORD


# SQLAlchemy connection cho RoomBeacon crawler
BRONZE_DATABASE_URL=mysql+pymysql://${BRONZE_MYSQL_USER}:${BRONZE_MYSQL_PASSWORD}@${BRONZE_MYSQL_HOST}:${BRONZE_MYSQL_PORT}/${BRONZE_MYSQL_DATABASE}

# Giữ compatibility với crawler hiện tại nếu code đang đọc DATABASE_URL
DATABASE_URL=${BRONZE_DATABASE_URL}


# ============================================================
# MYSQL #2 — AIRFLOW METADATA DATABASE
# ============================================================

AIRFLOW_MYSQL_CONTAINER_NAME=roombeacon-mysql-airflow

AIRFLOW_MYSQL_HOST=mysql-airflow
AIRFLOW_MYSQL_PORT=3306

# Chỉ dùng khi cần debug từ host.
# Production không nên expose metadata DB.
AIRFLOW_MYSQL_HOST_PORT=3308

AIRFLOW_MYSQL_ROOT_PASSWORD=CHANGE_ME_AIRFLOW_MYSQL_ROOT_PASSWORD

AIRFLOW_MYSQL_DATABASE=airflow

AIRFLOW_MYSQL_USER=airflow
AIRFLOW_MYSQL_PASSWORD=CHANGE_ME_AIRFLOW_MYSQL_PASSWORD


# ============================================================
# AIRFLOW — IMAGE / RUNTIME
# ============================================================

AIRFLOW_CONTAINER_NAME_PREFIX=roombeacon-airflow

AIRFLOW_HOME=/opt/airflow

# Linux:
# id -u
AIRFLOW_UID=1000

AIRFLOW_API_PORT=8080

AIRFLOW_DAGS_DIR=./airflow/dags
AIRFLOW_LOGS_DIR=./airflow/logs
AIRFLOW_CONFIG_DIR=./airflow/config
AIRFLOW_PLUGINS_DIR=./airflow/plugins


# ============================================================
# AIRFLOW — CORE
# ============================================================

# Giai đoạn hiện tại chưa cần Redis / Celery.
AIRFLOW__CORE__EXECUTOR=LocalExecutor

AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true

AIRFLOW__CORE__DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=true


# ============================================================
# AIRFLOW — METADATA DATABASE
# ============================================================

# Airflow khuyến nghị mysqlclient / mysqldb driver
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=mysql+mysqldb://${AIRFLOW_MYSQL_USER}:${AIRFLOW_MYSQL_PASSWORD}@${AIRFLOW_MYSQL_HOST}:${AIRFLOW_MYSQL_PORT}/${AIRFLOW_MYSQL_DATABASE}

AIRFLOW__DATABASE__SQL_ENGINE_COLLATION_FOR_IDS=utf8mb3_bin

AIRFLOW__DATABASE__SQL_ALCHEMY_POOL_PRE_PING=true

AIRFLOW__DATABASE__SQL_ALCHEMY_POOL_RECYCLE=1800


# ============================================================
# AIRFLOW — MYSQL PYTHON DEPENDENCY
# ============================================================

# Dùng khi build custom Airflow image.
AIRFLOW_MYSQL_PROVIDER=apache-airflow-providers-mysql
AIRFLOW_MYSQL_DRIVER=mysqlclient


# ============================================================
# AIRFLOW — SECURITY / ENCRYPTION
# ============================================================

# Generate bằng:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

AIRFLOW__CORE__FERNET_KEY=CHANGE_ME_GENERATE_REAL_FERNET_KEY


# ============================================================
# AIRFLOW — SIMPLE AUTH MANAGER
# DEVELOPMENT ONLY
# ============================================================

AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:admin,viewer:viewer

AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_ALL_ADMINS=false

AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_PASSWORDS_FILE=/opt/airflow/config/simple_auth_manager_passwords.json.generated


# ============================================================
# MINIO — RAW OBJECT STORAGE
# ============================================================

MINIO_CONTAINER_NAME=roombeacon-minio

MINIO_HOST=minio
MINIO_PORT=9000

MINIO_ENDPOINT=minio:9000

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_SECURE=false

MINIO_ROOT_USER=CHANGE_ME_MINIO_ADMIN
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ADMIN_PASSWORD


# ============================================================
# MINIO — BUCKETS
# ============================================================

MINIO_BUCKET_RAW=roombeacon-raw
MINIO_BUCKET_ASSETS=roombeacon-assets
MINIO_BUCKET_QUARANTINE=roombeacon-quarantine
MINIO_BUCKET_EXPORTS=roombeacon-exports


# ============================================================
# MINIO — SERVICE ACCOUNT FOR CRAWLER
# ============================================================

MINIO_CRAWLER_ACCESS_KEY=CHANGE_ME_CRAWLER_ACCESS_KEY
MINIO_CRAWLER_SECRET_KEY=CHANGE_ME_CRAWLER_SECRET_KEY


# ============================================================
# CRAWLER
# ============================================================

CRAWLER_ENV=development

CRAWLER_LOG_LEVEL=INFO

CRAWLER_DATA_DIR=/data

CRAWLER_USER_AGENT=RoomBeaconCrawler/0.1

CRAWLER_OBEY_ROBOTS_TXT=true

PLAYWRIGHT_HEADLESS=true


# ============================================================
# CRAWLER — NETWORK / REQUEST POLICY
# ============================================================

CRAWLER_REQUEST_TIMEOUT_SECONDS=30

CRAWLER_REQUEST_DELAY_SECONDS=2

CRAWLER_MAX_CONCURRENCY=2

CRAWLER_MAX_RETRIES=2

CRAWLER_RETRY_BACKOFF_SECONDS=5


# ============================================================
# CRAWLER — LIMITS
# ============================================================

CRAWLER_START_PAGE=1

CRAWLER_MAX_PAGES=5

CRAWLER_MAX_RECORDS_PER_PAGE=50

CRAWLER_MAX_TOTAL_RECORDS=250


# ============================================================
# CRAWLER — DATE POLICY
# ============================================================

# LATEST | DATE_RANGE | FULL_HISTORY
CRAWLER_DATE_MODE=LATEST

CRAWLER_DATE_FROM=
CRAWLER_DATE_TO=


# ============================================================
# DUCKDB / PROCESSING
# ============================================================

DUCKDB_CONTAINER_NAME=roombeacon-processing

# DuckDB không phải server.
# Đây là file DB bên trong processing container.
DUCKDB_DATABASE=/data/duckdb/roombeacon.duckdb

DUCKDB_TEMP_DIRECTORY=/data/duckdb/tmp

DUCKDB_MEMORY_LIMIT=4GB

DUCKDB_THREADS=4


# ============================================================
# PROCESSING — INPUT
# ============================================================

PROCESSING_INPUT_DATABASE=mysql

PROCESSING_BRONZE_DATABASE_URL=${BRONZE_DATABASE_URL}

PROCESSING_BRONZE_SCHEMA=roombeacon_bronze


# ============================================================
# PROCESSING — OUTPUT
# ============================================================

PROCESSING_SILVER_DIR=/data/silver

PROCESSING_OUTPUT_FORMAT=parquet

PROCESSING_PARQUET_COMPRESSION=zstd


# ============================================================
# PROCESSING PIPELINE
# ============================================================

PIPELINE_VALIDATION_ENABLED=true

PIPELINE_CLEANING_ENABLED=true

PIPELINE_NORMALIZATION_ENABLED=true

PIPELINE_DEDUPLICATION_ENABLED=true

PIPELINE_ENRICHMENT_ENABLED=true


# ============================================================
# CLICKHOUSE — FINAL ANALYTICAL DATABASE
# ============================================================

CLICKHOUSE_CONTAINER_NAME=roombeacon-clickhouse

CLICKHOUSE_HOST=clickhouse

CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Host ports
CLICKHOUSE_HOST_HTTP_PORT=8123

# Không dùng 9000 vì MinIO host đã dùng 9000
CLICKHOUSE_HOST_NATIVE_PORT=9002


# ============================================================
# CLICKHOUSE — DATABASE
# ============================================================

CLICKHOUSE_DATABASE=roombeacon_analytics

CLICKHOUSE_ADMIN_USER=roombeacon_admin
CLICKHOUSE_ADMIN_PASSWORD=CHANGE_ME_CLICKHOUSE_ADMIN_PASSWORD


# ============================================================
# CLICKHOUSE — PROCESSING WRITER
# ============================================================

CLICKHOUSE_WRITER_USER=roombeacon_writer
CLICKHOUSE_WRITER_PASSWORD=CHANGE_ME_CLICKHOUSE_WRITER_PASSWORD


# ============================================================
# CLICKHOUSE — BACKEND READONLY
# ============================================================

CLICKHOUSE_READER_USER=roombeacon_reader
CLICKHOUSE_READER_PASSWORD=CHANGE_ME_CLICKHOUSE_READER_PASSWORD


# ============================================================
# CLICKHOUSE CONNECTIONS
# ============================================================

CLICKHOUSE_HTTP_URL=http://${CLICKHOUSE_HOST}:${CLICKHOUSE_HTTP_PORT}

CLICKHOUSE_WRITER_URL=http://${CLICKHOUSE_WRITER_USER}:${CLICKHOUSE_WRITER_PASSWORD}@${CLICKHOUSE_HOST}:${CLICKHOUSE_HTTP_PORT}/${CLICKHOUSE_DATABASE}

CLICKHOUSE_READER_URL=http://${CLICKHOUSE_READER_USER}:${CLICKHOUSE_READER_PASSWORD}@${CLICKHOUSE_HOST}:${CLICKHOUSE_HTTP_PORT}/${CLICKHOUSE_DATABASE}


# ============================================================
# ANALYTICS
# ============================================================

ANALYTICS_INPUT_LAYER=silver

ANALYTICS_SILVER_DIR=/data/silver

ANALYTICS_GOLD_DIR=/data/gold

ANALYTICS_TARGET_DATABASE=clickhouse


# ============================================================
# BACKEND API
# ============================================================

BACKEND_HOST=backend
BACKEND_PORT=8000

BACKEND_HOST_PORT=8000

BACKEND_ENV=development

BACKEND_LOG_LEVEL=INFO

BACKEND_CLICKHOUSE_URL=${CLICKHOUSE_READER_URL}


# ============================================================
# NGINX / EDGE
# ============================================================

NGINX_CONTAINER_NAME=roombeacon-nginx

NGINX_HTTP_PORT=8088
NGINX_HTTPS_PORT=8443

NGINX_TLS_ENABLED=false


# ============================================================
# SECURITY — DEVELOPMENT DEFAULTS
# ============================================================

TLS_ENABLED=false

ALLOW_PUBLIC_MYSQL=false
ALLOW_PUBLIC_CLICKHOUSE=false
ALLOW_PUBLIC_AIRFLOW_METADATA_DB=false

ALLOW_PUBLIC_MINIO_API=false
ALLOW_PUBLIC_MINIO_CONSOLE=true

ALLOW_PUBLIC_AIRFLOW_UI=true


# ============================================================
# CONTAINER HARDENING
# ============================================================

DOCKER_RESTART_POLICY=unless-stopped

CONTAINER_NO_NEW_PRIVILEGES=true

CONTAINER_DROP_ALL_CAPABILITIES=true


# ============================================================
# BACKUP
# ============================================================

BACKUP_ENABLED=true

BACKUP_DIR=/backups

BACKUP_RETENTION_DAYS=14

MYSQL_BACKUP_ENABLED=true
CLICKHOUSE_BACKUP_ENABLED=true
MINIO_BACKUP_ENABLED=true


# ============================================================
# DEVELOPMENT
# ============================================================

DEBUG=false